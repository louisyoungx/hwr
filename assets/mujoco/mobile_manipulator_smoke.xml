<mujoco model="hwr_dual_arm_household_robot_smoke_v2">
  <compiler angle="radian" autolimits="true" inertiafromgeom="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast">
    <flag multiccd="enable"/>
  </option>
  <size memory="32M"/>

  <visual>
    <global offwidth="640" offheight="480"/>
    <quality shadowsize="4096"/>
    <headlight ambient="0.25 0.25 0.25" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2"/>
  </visual>

  <asset>
    <include file="common/robot_assets.xml"/>
    <texture name="floor_checker" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.20 0.23 0.27" rgb2="0.34 0.38 0.43"/>
    <material name="floor_material" texture="floor_checker" texrepeat="8 8" reflectance="0.08"/>
    <material name="object_material" rgba="0.72 0.08 0.06 1" metallic="0.05" roughness="0.6"/>
  </asset>

  <default>
    <include file="common/robot_defaults.xml"/>
  </default>

  <worldbody>
    <geom name="floor" type="plane" size="4 4 0.1" material="floor_material"/>
    <light name="key_light" pos="1.5 -2.0 3.5" dir="-0.2 0.3 -1" directional="true" castshadow="true"/>
    <light name="fill_light" pos="-2.0 1.5 2.4" diffuse="0.45 0.50 0.58" castshadow="true"/>
    <camera name="third_person" pos="3.1 -3.1 2.5" xyaxes="0.707 0.707 0 -0.350 0.350 0.869" fovy="48"/>
    <include file="common/robot_body.xml"/>
    <body name="smoke_table" pos="0.90 0 0.35">
      <geom name="smoke_table_top" type="box" pos="0 0 0.33" size="0.45 0.45 0.035"
            material="body_material"/>
      <geom type="box" pos="0 0 0.15" size="0.08 0.08 0.15" material="body_material"/>
    </body>
    <body name="smoke_object" pos="1.1 0 0.79">
      <freejoint name="smoke_object_free"/>
      <geom name="smoke_object_geom" type="box" size="0.055 0.04 0.09" mass="0.12"
            material="object_material" friction="1.5 0.03 0.003"/>
    </body>
  </worldbody>

  <contact>
    <include file="common/robot_contacts.xml"/>
  </contact>
  <actuator>
    <include file="common/robot_actuators.xml"/>
  </actuator>
  <sensor>
    <include file="common/robot_sensors.xml"/>
  </sensor>
</mujoco>
